#!/usr/bin/env bash
set -euxo pipefail

export DEBIAN_FRONTEND=noninteractive

apt-get update
apt-get install -y ca-certificates curl git docker.io docker-compose

systemctl enable --now docker

mkdir -p /opt/se3s
cd /opt/se3s

if [ ! -d app/.git ]; then
  git clone "${source_repo_url}" app
fi

cd /opt/se3s/app
git fetch --all --tags
git checkout "${source_ref}"
git pull --ff-only || true

cat > .env <<ENV
REDIS_HOST=${redis_host}
EVENT_ID=${event_id}
QUEUE_POP_TIMEOUT_SECONDS=5
ENV

if [ "${node_role}" = "coordinator" ]; then
  docker-compose -f docker-compose.gcp.yml up -d --build --scale worker=${worker_replicas_per_node}

  until docker-compose -f docker-compose.gcp.yml exec -T redis redis-cli ping; do
    sleep 2
  done

  docker-compose -f docker-compose.gcp.yml exec -T redis redis-cli SET event:${event_id}:seats_available ${initial_seats}
elif [ "${node_role}" = "worker" ]; then
  until docker run --rm redis:7-alpine redis-cli -h "${redis_host}" ping; do
    sleep 2
  done

  docker-compose -f docker-compose.gcp-worker.yml up -d --build --scale worker=${worker_replicas_per_node}
else
  cat > /usr/local/bin/run-k6.sh <<'SCRIPT'
#!/usr/bin/env bash
set -euo pipefail

SCENARIO="$${1:-constant_load.js}"

cd /opt/se3s/app

sudo docker run --rm \
  -e BASE_URL="$${BASE_URL:-}" \
  -e EVENT_ID="$${EVENT_ID:-1}" \
  -e K6_VUS="$${K6_VUS:-}" \
  -e K6_DURATION="$${K6_DURATION:-}" \
  -e K6_STAGES="$${K6_STAGES:-}" \
  -v /opt/se3s/app/tests/k6:/scripts:ro \
  grafana/k6:latest run "/scripts/$${SCENARIO}"
SCRIPT

  chmod +x /usr/local/bin/run-k6.sh
fi
